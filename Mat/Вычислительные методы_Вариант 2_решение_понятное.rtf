{\rtf1\ansi\deff0{\fonttbl{\f0 Times New Roman;}{\f1 Courier New;}}\paperw11906\paperh16838\margl1200\margr1200\margt1000\margb1000\pard\qc\f0\fs32\b \u1042?\u1067?\u1063?\u1048?\u1057?\u1051?\u1048?\u1058?\u1045?\u1051?\u1068?\u1053?\u1067?\u1045? \u1052?\u1045?\u1058?\u1054?\u1044?\u1067?\par\pard\sa80\f1\fs21 \u1055?\u1086?\u1076?\u1088?\u1086?\u1073?\u1085?\u1086?\u1077? \u1088?\u1077?\u1096?\u1077?\u1085?\u1080?\u1077? \u1079?\u1072?\u1076?\u1072?\u1085?\u1080?\u1081?. \u1042?\u1072?\u1088?\u1080?\u1072?\u1085?\u1090? 2\par\pard\sa240\sb120\f0\fs26\b \u1051?\u1048?\u1057?\u1058? 1. \u1047?\u1040?\u1044?\u1040?\u1063?\u1040? 1. \u1054?\u1062?\u1045?\u1053?\u1050?\u1040? \u1055?\u1054?\u1043?\u1056?\u1045?\u1064?\u1053?\u1054?\u1057?\u1058?\u1045?\u1049?\par\pard\sa80\f1\fs21 \u1044?\u1072?\u1085?\u1086?:\par\pard\sa80\f1\fs21 a = 3.47, \u916?a = 0.01; b = 3.58, \u916?b = 0.02; c = 0.184, \u916?c = 0.004.\par\pard\sa80\f1\fs21 \u1060?\u1086?\u1088?\u1084?\u1091?\u1083?\u1099? \u1074?\u1072?\u1088?\u1080?\u1072?\u1085?\u1090?\u1072? 2:\par\pard\sa80\f1\fs21 S1 = 3c^2 / sqrt(b - a),     S2 = a^2 sqrt(b) / c^2.\par\pard\sa80\f1\fs21 1. \u1042?\u1099?\u1095?\u1080?\u1089?\u1083?\u1077?\u1085?\u1080?\u1077? S1\par\pard\sa80\f1\fs21 b - a = 3.58 - 3.47 = 0.11.\par\pard\sa80\f1\fs21 c^2 = 0.184^2 = 0.033856.\par\pard\sa80\f1\fs21 sqrt(b - a) = sqrt(0.11) = 0.331662.\par\pard\sa80\f1\fs21 S1 = 3*0.033856 / 0.331662 = 0.306239.\par\pard\sa80\f1\fs21 \u1054?\u1090?\u1085?\u1086?\u1089?\u1080?\u1090?\u1077?\u1083?\u1100?\u1085?\u1072?\u1103? \u1087?\u1086?\u1075?\u1088?\u1077?\u1096?\u1085?\u1086?\u1089?\u1090?\u1100?:\par\pard\sa80\f1\fs21 \u916?S1/S1 = (\u916?a + \u916?b)/(2(b-a)) + 2\u916?c/c.\par\pard\sa80\f1\fs21 \u916?S1/S1 = 0.03/(2*0.11) + 2*0.004/0.184\par\pard\sa80\f1\fs21         = 0.136364 + 0.043478 = 0.179842.\par\pard\sa80\f1\fs21 \u948?S1 = 17.9842%.\par\pard\sa80\f1\fs21 \u1040?\u1073?\u1089?\u1086?\u1083?\u1102?\u1090?\u1085?\u1072?\u1103? \u1087?\u1086?\u